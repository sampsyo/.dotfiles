window-width = 80
window-height = 24
cursor-style-blink = false
cursor-style = block
theme = IR Black
font-thicken = true
background-opacity = 0.87
background-blur-radius = 40
cursor-color = #ffa560
window-padding-x = 6
window-padding-y = 4

font-size = 11
font-feature = -calt
font-feature = -liga
font-feature = -dlig

keybind = command+enter=text:\n
keybind = command+c=copy_to_clipboard:plain
keybind = command+shift+c=copy_to_clipboard:mixed

window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = true
window-inherit-font-size = false
