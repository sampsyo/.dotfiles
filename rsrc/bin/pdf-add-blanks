#!/bin/sh

# Generate blank PDF.
# https://unix.stackexchange.com/a/277967
cat > /tmp/blank.pdf << ENDPDF
%PDF-1.4
1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj
2 0 obj<</Type/Pages/Count 1/Kids[3 0 R]>>endobj
3 0 obj<</Type/Page/MediaBox[0 0 612 792]/Parent 2 0 R/Resources<<>>>>endobj
xref
0 4
0000000000 65535 f 
0000000009 00000 n 
0000000052 00000 n 
0000000101 00000 n 
trailer<</Size 4/Root 1 0 R>>
startxref
178
%%EOF
ENDPDF

# Insert blanks.
PAGES=`qpdf --show-npages "$1"`
OUTFILE=`basename "$1" .pdf`.blanks.pdf
BLANKS=`seq $PAGES | xargs -n 1 | (xargs -I {} echo -n  1,;echo) | sed 's/,$//'`
qpdf --collate --empty --pages "$1" . /tmp/blank.pdf $BLANKS -- "$OUTFILE"

# Remove temporary file.
rm -f /tmp/blank.pdf
